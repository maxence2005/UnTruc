{
  "name": "untruc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "UnTruc - jeu.untruc.fr",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "smoke": "tsc --noEmit && vite build",
